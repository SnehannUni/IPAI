        },
        {
          "simple": "Cleaner finishes all tables",
          "tech": "autovacuum keeps up"
        },
        {
          "simple": "Numbers stay far below the limit",
          "tech": "XID age low"
        },
        {
          "simple": "All errors arrive",
          "tech": "no lost events"
