      "kind": "fix",
      "label": "Solution",
      "headline": {
        "simple": "Solution: The cleaner starts earlier, has more helpers and takes no breaks.",
        "tech": "Fix: more aggressive autovacuum – freeze_max_age 500 million, 6 workers, cost_delay 0, new hardware."
      },
      "chain": [
        {
          "simple": "Many saves use up numbers",
