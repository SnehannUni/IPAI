  "views": [
    {
      "id": "bug",
      "kind": "bug",
      "label": "Bug",
      "headline": {
        "simple": "Problem: Sentry accepts no new errors for a whole day. Why?",
        "tech": "Bug: PostgreSQL refuses writes due to imminent XID wraparound."
      },
      "chain": [
        {
          "simple": "Many saves use up numbers",
          "tech": "high write load consumes XIDs"
        },
        {
          "simple": "Cleaner stuck on giant table",
          "tech": "autovacuum too slow"
        },
        {
          "simple": "Numbers almost gone – database locks",
          "tech": "wraparound protection: no writes"
        },
        {
          "simple": "New errors get lost",
          "tech": "events backed up and dropped"
        }
      ],
      "steps": [
        {
          "edges": [
            "aq"
          ],
          "packet": {
            "simple": "Error",
            "tech": "Event"
          },
          "text": {
            "simple": "Your app reports an error to Sentry, and the report lands in the waiting list.",
            "tech": "The SDK sends an event; it lands in the queue."
          },
          "set": {
            "queue": {
              "slots": 1,
              "status": {
                "simple": "1 report",
                "tech": "1 event"
              }
            }
          }
        },
        {
          "edges": [
            "qw",
            "wd"
          ],
          "text": {
            "simple": "The processor saves it, and every save uses up one number from a supply of about 2 billion.",
            "tech": "The worker writes the event; every writing transaction gets a transaction ID (XID), limit about 2 billion."
          },
          "set": {
            "queue": {
              "slots": 0,
              "status": "empty"
            },
            "db": {
              "meter": 72
            }
          }
        },
        {
          "edges": [
            "du"
          ],
          "text": {
            "simple": "You see the new error in your overview.",
            "tech": "The event appears in the issue stream."
          },
          "set": {
            "ui": {
              "status": {
                "simple": "1 new error",
                "tech": "1 new event"
              },
              "tone": "ok"
            }
          }
        },
        {
          "focus": "vacuum",
          "text": {
            "simple": "In the background, a cleaner frees up old numbers, but only once it has finished all tables.",
            "tech": "Autovacuum freezes old rows; the XID age only drops once the oldest table is done too."
          }
        },
        {
          "edges": [
            "vd"
          ],
          "text": {
            "simple": "It finishes the small and large tables, but is still working on the giant table.",
            "tech": "Most relations are vacuumed, the large mapping table is not yet."
          },
          "set": {
            "vacuum": {
              "check": {
                "0": "done",
                "1": "done"
              }
            }
          }
        },
        {
          "edges": [
            "aq",
            "qw",
            "wd"
          ],
          "chain": 0,
          "packet": {
            "simple": "many errors",
            "tech": "many events"
          },
          "text": {
            "simple": "Meanwhile, Sentry keeps saving new reports, and each one uses up another number.",
            "tech": "Sentry is very write-heavy: XIDs are consumed faster than autovacuum freezes them."
          },
          "set": {
            "db": {
              "meter": 92
            }
          }
        },
        {
          "focus": "vacuum",
          "error": true,
          "chain": 1,
          "text": {
            "simple": "The cleaner gets stuck on the giant table and does not finish in time.",
            "tech": "freeze_max_age too high, only 3 workers, heavy cost delay: the vacuum of the mapping table never finishes."
          },
          "set": {
            "vacuum": {
              "check": {
                "2": "fail"
              },
              "badge": {
                "simple": "too slow",
                "tech": "stuck"
              }
            },
            "db": {
              "meter": 99
            }
          }
        },
        {
          "edges": [
            "wd",
            "dw"
          ],
          "error": true,
          "chain": 2,
          "text": {
            "simple": "With only one million free numbers left, the database locks itself so that no data gets corrupted.",
            "tech": "Fewer than 1 million XIDs left: PostgreSQL refuses all writes to prevent wraparound and data loss."
          },
          "set": {
            "db": {
              "meter": 100,
              "state": "dead",
              "status": {
                "simple": "locked",
                "tech": "read-only"
              },
              "tone": "bad"
            }
          }
        },
        {
          "edges": [
            "aq"
          ],
          "error": true,
          "packet": {
            "simple": "Error",
            "tech": "Event"
          },
          "text": {
            "simple": "New reports keep arriving and pile up in the waiting list.",
            "tech": "Events keep coming in; queue and buffers fill up."
          },
          "set": {
            "queue": {
              "slots": 5,
              "status": {
                "simple": "backed up",
                "tech": "backlog grows"
              },
              "tone": "bad"
            }
          }
        },
        {
          "edges": [
            "du"
          ],
          "error": true,
          "chain": 3,
          "labels": {
            "du": {
              "simple": "nothing new",
              "tech": "stale data only"
            }
          },
          "text": {
            "simple": "For hours your overview shows no new errors, and the backed-up reports are thrown away in the end.",
            "tech": "Outage across the US workday; the event backlog is dropped."
          },
          "set": {
            "ui": {
              "status": {
                "simple": "no new errors",
                "tech": "no new events"
              },
              "tone": "bad",
              "state": "dead"
            },
            "queue": {
              "slots": 0,
              "status": {
                "simple": "thrown away",
                "tech": "dropped"
              },
              "tone": "bad"
            }
          }
        }
      ]
    },
