        {
          "simple": "Aufräumer hängt an Riesen-Tabelle",
          "tech": "Autovacuum zu langsam"
        },
        {
          "simple": "Nummern fast weg – Datenbank sperrt",
          "tech": "Wraparound-Schutz: keine Writes"
        },
        {
          "simple": "Neue Fehler gehen verloren",
          "tech": "Events gestaut und verworfen"
        }
