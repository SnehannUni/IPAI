    "html": "<div class='page'><h2>Konto anlegen</h2><label>Name<div class='f'>Mira Kaya</div></label><label>E-Mail<div class='f mail'><span class='old'>mira@firma.de</span><span class='new'>m.kaya@firma.de</span></div><p class='err' data-ipai='emailErr'>Diese Adresse hat schon ein Konto. <a class='alt' data-ipai='alt'>Andere verwenden</a></p></label><button class='go' data-ipai='submit'><span class='l'>Konto anlegen</span><span class='w'>Prüft …</span></button><div class='ok' data-ipai='ok'>✓ Konto angelegt. Wir haben dir eine Mail geschickt.</div></div>",
    "css": ".page{padding:20px 24px;height:100%;background:#fff}h2{margin:0 0 14px;font-size:18px;color:#1e293b}label{display:block;font-size:12px;color:#475569;margin-bottom:12px}.f{margin-top:4px;padding:8px 10px;border:1px solid #cbd5e1;border-radius:8px;font-size:13.5px;color:#0f172a}.new,.err,.ok,.w{display:none}.err{margin:5px 0 0;font-size:12px;color:#b91c1c}.alt{color:#4338ca;text-decoration:underline;cursor:pointer}.go{width:100%;margin-top:4px;padding:10px;border:0;border-radius:8px;background:#4338ca;color:#fff;font:inherit;font-size:14px;font-weight:600}.ok{margin-top:12px;padding:10px 12px;border-radius:8px;background:#ecfdf5;color:#065f46;font-size:12.5px}[data-state~=checking] .l{display:none}[data-state~=checking] .w{display:inline}[data-state~=checking] .go{opacity:.7}[data-state~=taken] .mail{border-color:#dc2626;background:#fef2f2}[data-state~=taken] .err{display:block}[data-state~=fixed] .old{display:none}[data-state~=fixed] .new{display:inline}[data-state~=fixed] .mail{border-color:#cbd5e1;background:#fff}[data-state~=fixed] .err{display:none}[data-state~=done] .ok{display:block}[data-state~=done] .go{background:#94a3b8}"
  },
