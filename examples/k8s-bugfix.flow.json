            "kw": {
              "simple": "please stop",
              "tech": "SIGTERM"
            }
          },
          "text": {
            "simple": "Kubernetes asks the worker to stop – and gives it time to finish.",
            "tech": "SIGTERM instead of kill. The pod gets a grace period for the running job."
          },
          "set": {
            "worker": {
              "badge": {
                "simple": "finishing …",
                "tech": "terminating"
              }
            }
          },
          "detail": {
            "simple": "Instead of shutting it down at once, Kubernetes gives the worker a deadline. During that time it takes no new questions but finishes the current one.",
            "tech": "The SIGTERM handler stops the consumer and finishes the running job; grace period e.g. 60 s."
          }
        },
        {
          "edges": [
            "wq"
          ],
          "chain": 2,
          "tag": "new",
          "text": {
            "simple": "It tells the waiting list “done”. The question is ticked off.",
            "tech": "The worker sends the ack. The job is removed from the queue."
          },
          "set": {
            "worker": {
              "check": {
                "3": "ok"
              }
            },
            "queue": {
              "status": {
                "simple": "ticked off",
                "tech": "acked"
              },
              "tone": "ok"
            }
          },
          "detail": {
            "simple": "Now the list is complete. The waiting list knows the question is done and does not hand it out again.",
            "tech": "Ack before exit, so no redelivery."
          }
        },
        {
          "focus": "worker",
          "text": {
            "simple": "Only now does it stop. The new worker takes over from the next question on.",
            "tech": "The pod shuts down cleanly; the new pod takes over new jobs."
          },
          "set": {
