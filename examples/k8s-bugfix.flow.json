  "views": [
    {
      "id": "bug",
      "kind": "bug",
      "label": "Bug",
      "headline": {
        "simple": "Problem: Sometimes the answer shows up twice. Why?",
        "tech": "Bug: Duplicates on the client after deployments."
      },
      "chain": [
        {
          "simple": "Update arrives",
          "tech": "Rolling update"
        },
        {
          "simple": "Worker is stopped mid-task",
          "tech": "Pod is killed immediately"
        },
        {
          "simple": "“Done” is missing – question comes again",
          "tech": "no ack → redelivery"
        },
        {
          "simple": "Answer twice",
          "tech": "Duplicate"
        }
      ],
      "steps": [
        {
          "edges": [
            "yq"
          ],
          "text": {
            "simple": "You ask a question.",
            "tech": "The request lands in the queue as a job."
          },
          "set": {
            "you": {
              "say": {
                "from": "user",
                "text": "What is RabbitMQ?"
              }
            },
            "queue": {
              "slots": 1,
              "status": {
                "simple": "1 question waiting",
                "tech": "1 ready"
              }
            }
          }
        },
        {
          "edges": [
            "qw"
          ],
          "text": {
            "simple": "A worker takes the question. The waiting list notes: not done yet.",
            "tech": "A pod receives the job. It stays reserved until the ack."
          },
          "set": {
            "queue": {
              "slots": 0,
              "status": {
                "simple": "waiting for “done”",
                "tech": "1 unacked"
              }
            },
            "worker": {
              "check": {
                "0": "done"
              }
            }
          }
        },
        {
          "edges": [
            "wc",
            "cw"
          ],
          "text": {
            "simple": "It asks Claude and gets the answer.",
            "tech": "LLM request and response."
          },
          "set": {
            "worker": {
              "check": {
                "1": "done"
              }
            }
          }
        },
        {
          "edges": [
            "wy"
          ],
          "text": {
            "simple": "The answer reaches you. One item is still missing: reporting “done”.",
            "tech": "The result is pushed. The ack is still pending."
          },
          "set": {
            "you": {
              "say": {
                "from": "ai",
                "text": "RabbitMQ is a message broker …"
              }
            },
            "worker": {
              "check": {
                "2": "done"
              }
            }
          }
        },
        {
          "focus": "kube",
          "chain": 0,
          "text": {
            "simple": "Right now the team rolls out an update. Kubernetes swaps out the workers.",
            "tech": "A rolling update starts. The old pods are replaced."
          },
          "set": {
            "kube": {
              "status": {
                "simple": "Update to version 2 running",
                "tech": "Rollout v2"
              },
              "tone": "strong"
            }
          },
          "detail": {
            "simple": "During an update, every running worker is replaced by the new version. This happens several times a week.",
            "tech": "The deployment controller replaces the pods with the new version step by step."
          }
        },
        {
          "edges": [
            "kw"
          ],
          "error": true,
          "chain": 1,
          "text": {
            "simple": "Kubernetes stops the worker at once. It no longer gets to report “done”.",
            "tech": "The pod is killed without shutdown handling. The ack is never sent."
          },
          "set": {
            "worker": {
              "state": "dead",
              "check": {
                "3": "fail"
              },
              "badge": {
                "simple": "stopped",
                "tech": "killed"
              }
            }
          },
          "detail": {
            "simple": "The worker had already sent the answer but did not get to the last item on its list. To the waiting list, it looks as if nothing happened at all.",
            "tech": "Without SIGTERM handling the process ends immediately. Answer pushed, ack missing."
          }
        },
        {
          "edges": [
            "qw"
          ],
          "error": true,
          "chain": 2,
          "text": {
            "simple": "The waiting list never heard “done”. It gives the question to the new worker.",
            "tech": "Without an ack the job is redelivered – to the new pod."
          },
          "setBefore": {
            "worker": {
              "state": null,
              "check": "reset",
              "badge": {
                "simple": "Version 2",
                "tech": "v2"
              }
            },
            "queue": {
              "slots": 1,
              "status": {
                "simple": "1 question waiting",
                "tech": "1 ready"
              }
            }
          },
          "set": {
            "worker": {
              "check": {
                "0": "done"
              }
            },
            "queue": {
              "slots": 0,
              "status": {
                "simple": "waiting for “done”",
                "tech": "1 unacked"
              }
            }
          },
          "detail": {
            "simple": "The waiting list wants to make sure no question gets lost. So it hands out every unconfirmed question once more.",
            "tech": "At-least-once: unacked messages are redelivered after the connection is lost."
          }
        },
        {
          "edges": [
            "wc",
            "cw"
          ],
          "error": true,
          "text": {
            "simple": "The new worker asks Claude again.",
            "tech": "Second LLM call for the same job."
          },
          "set": {
            "worker": {
              "check": {
                "1": "done"
              }
            }
          },
          "detail": {
            "simple": "It does not know the question was already answered, so it starts from scratch.",
            "tech": "No idempotency check: the new pod processes the job again in full."
          }
        },
        {
          "edges": [
            "wy"
          ],
          "error": true,
          "chain": 3,
          "text": {
            "simple": "You get the answer a second time.",
            "tech": "The client receives a duplicate."
          },
          "set": {
            "you": {
              "say": {
                "from": "ai",
                "text": "RabbitMQ is a message broker …",
                "tone": "bad",
                "note": {
                  "simple": "twice!",
                  "tech": "duplicate"
                }
              }
            },
            "worker": {
              "check": {
                "2": "done"
              }
            }
          },
          "detail": {
            "simple": "To you it looks as if Claude repeated itself. On top of that, Claude was paid for twice.",
            "tech": "Duplicate LLM call and duplicate message on the client."
          }
        }
      ],
      "explain": [
        {
          "simple": "Sometimes Claude's answer appears twice in the chat. This is not random: it happens whenever the team is rolling out an update.",
          "tech": "Duplicates only occur during deployments: a worker pod is killed after it has pushed the answer but before it has acked the job."
        },
        {
          "simple": "Every question waits on a waiting list until a worker reports “done”. If that report is missing, the waiting list assumes something went wrong and hands the question out once more.",
          "tech": "RabbitMQ holds the message until the ack. Without an ack it is redelivered after the connection drops – at-least-once delivery."
        }
      ]
    },
    {
      "id": "fix",
      "kind": "fix",
      "label": "Solution",
      "headline": {
        "simple": "Solution: During an update, the worker may finish its task first.",
        "tech": "Fix: graceful shutdown – catch SIGTERM, finish the job and ack it."
      },
      "chain": [
        {
          "simple": "Update arrives",
          "tech": "Rolling update"
        },
        {
          "simple": "Worker finishes first",
          "tech": "SIGTERM + grace period"
        },
        {
          "simple": "“Done” is reported",
          "tech": "Ack before exit"
        },
        {
          "simple": "Only one answer",
          "tech": "no duplicate"
        }
      ],
      "mark": {
        "edges": {
          "kw": "changed",
          "wq": "new"
        }
      },
