  "views": [
    {
      "id": "planned",
      "label": "Geplant",
      "kind": "normal",
      "headline": "Plan: Die Sidebar lässt sich einklappen und bleibt es, auch nach dem Neuladen.",
      "explain": [
        "Wer viel in der Rechnungsliste arbeitet, braucht die Breite. Heute ist die Sidebar immer offen und nimmt ein Viertel des Bildschirms.",
        "Geplant ist ein Knopf oben in der Sidebar. Die Wahl wird pro Nutzer gespeichert, damit sie nach dem Neuladen und auf anderen Geräten gilt."
      ],
      "steps": [
        {
          "on": "toggle",
          "edges": [
            "save"
          ],
          "packet": {
            "simple": "zu",
            "tech": "PUT"
          },
          "text": {
            "simple": "Du klickst auf «. Die Sidebar wird sofort schmal, und die Seite schickt deine Wahl los.",
            "tech": "Klick: collapsed lokal setzen, dann PUT /settings mit sidebar=collapsed."
          },
          "detail": {
            "simple": "Die Seite wartet nicht auf den Server, darum fühlt sich der Klick schnell an.",
            "tech": "Optimistisches Update im Store; der Request läuft danach."
          },
          "tag": "new",
          "demo": "collapsed saving"
        },
        {
          "edges": [
            "db"
          ],
          "packet": {
            "simple": "zu",
            "tech": "UPDATE"
          },
          "text": {
            "simple": "Die Einstellungen legen sie für dich ab.",
            "tech": "Die Settings-API schreibt user_settings.sidebar."
          },
          "set": {
            "db": {
              "status": {
                "simple": "Sidebar: zu",
                "tech": "sidebar=collapsed"
              },
              "tone": "ok"
            }
          }
        },
        {
          "edges": [
            "ok"
          ],
          "packet": "OK",
          "text": {
            "simple": "Die Antwort landet beim Hinweis „Speichert …“, und der verschwindet.",
            "tech": "204 No Content; der Speicher-Hinweis wird ausgeblendet."
          },
          "demo": "collapsed"
        },
        {
          "on": "reload",
          "edges": [
            "load"
          ],
          "packet": {
            "simple": "Vorlieben?",
            "tech": "GET"
          },
          "text": {
            "simple": "Du lädst neu. Die Seite fragt zuerst nach deinen Vorlieben.",
            "tech": "Reload: vor dem ersten Render GET /settings."
          },
          "detail": {
            "simple": "So springt die Sidebar nicht erst auf und dann wieder zu.",
            "tech": "Die Einstellungen kommen vor dem ersten Paint, sonst flackert das Layout."
          },
          "tag": "new",
          "demo": "collapsed loading"
        },
        {
          "edges": [
            "db"
          ],
          "labels": {
            "db": "liest"
          },
          "packet": {
            "simple": "zu",
            "tech": "SELECT"
          },
          "text": {
            "simple": "Die Einstellungen schauen in der Ablage nach.",
            "tech": "Die API liest user_settings.sidebar."
          }
        },
        {
          "edges": [
            "give"
          ],
          "packet": {
            "simple": "zu",
            "tech": "collapsed"
          },
          "text": {
            "simple": "Die Antwort landet bei der Sidebar: sie bleibt eingeklappt.",
            "tech": "Die App rendert mit collapsed: true."
          },
          "demo": "collapsed reloaded"
        }
      ]
    }
  ]
