    "title": "Assistent – geplant",
    "device": "phone",
    "html": "<div class='chat'><header class='top'><b>Assistent</b><span class='on'>online</span></header><div class='msgs'><div class='b ai'>Hallo! Wobei kann ich helfen?</div><div class='b me' data-ipai='mine'>Fasse die Rechnungen vom Mai zusammen.<i class='tick'> ✓</i></div><div class='b ai ans' data-ipai='answer'><span class='typing'><i></i><i></i><i></i></span><span class='t1'>Im Mai gab es 14 Rechnungen über 18.420 €.</span><span class='t2'> Drei sind noch offen, die älteste seit 41 Tagen.</span><span class='tag'>Gestoppt</span></div><button class='retry' data-ipai='retry'>↻ Neu schreiben</button></div><footer class='bar'><div class='input'><span class='q'>Fasse die Rechnungen vom Mai zusammen.</span><span class='ph'>Nachricht …</span></div><button class='send' data-ipai='send'>➤</button><button class='stop' data-ipai='stop'>■</button></footer></div>",
    "css": ".chat{height:100%;display:flex;flex-direction:column;background:#f1f5f9}.top{display:flex;align-items:baseline;gap:8px;padding:14px 14px 10px;background:#0f766e;color:#fff}.top b{font-size:15px}.on{font-size:11px;opacity:.8}.msgs{flex:1;padding:12px;display:flex;flex-direction:column;gap:8px;overflow:hidden}.b{max-width:84%;padding:8px 11px;border-radius:14px;font-size:13px;line-height:1.4}.ai{align-self:flex-start;background:#fff;border:1px solid #e2e8f0;border-bottom-left-radius:4px}.me{align-self:flex-end;background:#0f766e;color:#fff;border-bottom-right-radius:4px}.tick{font-style:normal;font-size:11px;opacity:.85}.typing i{display:inline-block;width:6px;height:6px;margin-right:3px;border-radius:50%;background:#94a3b8;animation:blink 1s infinite}.typing i:nth-child(2){animation-delay:.2s}.typing i:nth-child(3){animation-delay:.4s}@keyframes blink{50%{opacity:.2}}.tag{margin-left:6px;font-size:11px;font-weight:600;color:#b45309}.retry{align-self:flex-start;border:1px solid #cbd5e1;background:#fff;border-radius:999px;padding:5px 11px;font:inherit;font-size:12px;color:#0f766e}.bar{display:flex;gap:8px;align-items:center;padding:10px;background:#fff;border-top:1px solid #e2e8f0}.input{flex:1;font-size:12.5px;padding:8px 10px;border:1px solid #cbd5e1;border-radius:18px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ph{color:#94a3b8}.send,.stop{width:34px;height:34px;border-radius:50%;border:0;color:#fff;font:inherit;display:grid;place-items:center}.send{background:#0f766e}.stop{background:#334155}.me,.ans,.retry,.stop,.tick,.t1,.t2,.tag,.ph{display:none}[data-state~=sent] .me,[data-state~=sent] .ans{display:block}[data-state~=sent] .q{display:none}[data-state~=sent] .ph{display:inline}[data-state~=sent] .send{display:none}[data-state~=sent] .stop{display:grid}[data-state~=ack] .tick{display:inline}[data-state~=answering] .typing{display:none}[data-state~=answering] .t1{display:inline}[data-state~=stopping] .stop{opacity:.4}[data-state~=stopped