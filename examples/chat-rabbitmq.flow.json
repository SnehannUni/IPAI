      "async": true,
      "views": [
        "failure"
      ]
    },
    {
      "id": "e5",
      "from": "worker",
      "to": "anth",
      "verb": {
        "simple": "asks",
        "tech": "request"
      }
    },
    {
      "id": "e6",
      "from": "anth",
      "to": "worker",
      "verb": {
        "simple": "answers",
        "tech": "response"
      }
    },
    {
      "id": "e7",
      "from": "worker",
      "to": "db",
      "verb": {
        "simple": "writes down",
        "tech": "INSERT"
      },
      "views": [
        "normal"
      ]
    },
    {
      "id": "e8",
      "from": "worker",
      "to": "gw",
      "verb": {
        "simple": "hands over",
        "tech": "publish"
      },
      "async": true
    },
    {
      "id": "e10",
      "from": "gw",
      "to": "result",
      "verb": {
        "simple": "delivers",
        "tech": "push"
