      "async": true
    },
    {
      "id": "e4",
      "from": "qreq",
      "to": "worker",
      "verb": {
        "simple": "takes",
        "tech": "consume"
      },
      "async": true
    },
    {
      "id": "er",
      "from": "worker",
      "to": "qreq",
      "verb": {
        "simple": "puts back",
        "tech": "requeue"
