  "edges": [
    {
      "id": "e1",
      "from": "btn",
      "to": "api",
      "verb": {
        "simple": "hands over",
        "tech": "POST"
      }
    },
    {
      "id": "ack",
      "from": "api",
      "to": "btn",
      "verb": {
        "simple": "confirms",
        "tech": "202"
      },
      "views": [
        "normal"
      ]
    },
    {
      "id": "e2",
      "from": "api",
      "to": "db",
      "verb": {
        "simple": "writes down",
        "tech": "INSERT"
      }
    },
    {
      "id": "e3",
      "from": "api",
      "to": "qreq",
      "verb": {
        "simple": "drops off",
