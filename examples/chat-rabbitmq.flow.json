      "async": true
    }
  ],
  "views": [
    {
      "id": "normal",
      "label": "Normal",
      "steps": [
        {
          "edges": [
            "e1"
          ],
          "packet": "“What is RabbitMQ?”",
          "text": {
            "simple": "You type your question and press Send. The question goes to the front desk.",
            "tech": "The submit event triggers POST /messages to the REST API."
          },
          "set": {
            "btn": {
              "status": {
                "simple": "sent",
                "tech": "sent"
              }
            },
            "result": {
              "say": {
                "from": "user",
                "text": "What is RabbitMQ?"
              }
            }
          }
        },
        {
          "edges": [
            "e2"
          ],
          "text": {
            "simple": "The front desk writes the question into the archive. That way the chat is never lost.",
            "tech": "The API stores the message in PostgreSQL via INSERT."
          },
          "set": {
            "db": {
              "status": {
                "simple": "1 entry",
                "tech": "1 row"
              }
            }
          }
        },
        {
          "edges": [
            "e3"
          ],
          "packet": {
            "simple": "Task",
            "tech": "job #42"
          },
          "text": {
            "simple": "The front desk does not wait for Claude. It puts the question on the waiting list and is free right away.",
            "tech": "The API publishes a job to chat.requests and does not block."
          },
          "set": {
            "qreq": {
              "slots": 1,
              "status": {
                "simple": "1 waiting",
                "tech": "1 message"
              }
            }
          }
        },
        {
          "edges": [
            "ack"
          ],
          "packet": {
            "simple": "received",
            "tech": "202 Accepted"
          },
          "text": {
            "simple": "You are told right away that your question has arrived.",
            "tech": "The API immediately responds with 202 Accepted."
          },
          "set": {
            "btn": {
              "status": {
                "simple": "Claude is typing …",
                "tech": "typing …"
              }
            }
          }
        },
        {
          "edges": [
            "e4"
          ],
          "text": {
            "simple": "A worker picks the question up from the waiting list.",
            "tech": "A worker consumes the job from chat.requests."
          },
          "set": {
            "qreq": {
              "slots": 0,
              "status": "empty"
            },
            "worker": {
              "status": {
                "simple": "working",
                "tech": "busy"
              },
              "tone": "strong"
            }
          }
        },
        {
          "edges": [
            "e5"
          ],
          "packet": {
            "simple": "Question + chat so far",
            "tech": "POST /v1/messages"
          },
          "text": {
            "simple": "The worker passes the question and the chat so far to Claude and waits.",
            "tech": "The worker calls the Messages API with the history."
          },
          "set": {
            "worker": {
              "status": {
                "simple": "waiting for Claude",
                "tech": "await response"
              }
            }
          }
        },
        {
          "edges": [
            "e6"
          ],
          "text": {
            "simple": "Claude sends back the finished answer.",
            "tech": "The API returns 200 OK with the answer text."
          },
          "set": {
            "worker": {
              "status": {
                "simple": "working",
                "tech": "busy"
              }
            }
          }
        },
        {
          "edges": [
            "e7"
          ],
          "text": {
            "simple": "The answer goes into the archive too.",
            "tech": "The worker stores the assistant message."
          },
          "set": {
            "db": {
              "status": {
                "simple": "2 entries",
                "tech": "2 rows"
              }
            }
          }
        },
        {
          "edges": [
            "e8"
          ],
          "text": {
            "simple": "The worker hands the answer to the courier and is free again.",
            "tech": "The worker publishes the result to chat.responses and acks the job."
          },
          "set": {
            "worker": {
              "status": {
                "simple": "ready",
                "tech": "idle"
              },
              "tone": null
            }
          }
        },
        {
          "edges": [
            "e10"
          ],
          "text": {
            "simple": "Over the open line, the courier brings the answer to you.",
            "tech": "Push over the existing WebSocket connection."
          },
          "set": {
            "result": {
              "say": {
                "from": "ai",
                "text": "RabbitMQ is a message broker: it distributes messages through queues."
              }
            },
            "btn": {
              "status": {
                "simple": "done",
                "tech": "done"
              }
            }
          }
        },
        {
          "focus": "result",
          "text": {
            "simple": "The answer is in your chat.",
            "tech": "The frontend renders the assistant message."
          },
          "set": {
            "result": {
              "state": "good"
            }
          }
        }
      ]
    },
    {
      "id": "failure",
      "label": "Failure case",
      "headline": {
        "simple": "Failure case: Claude is overloaded – but the question still isn't lost.",
        "tech": "Failure case: 529 Overloaded, retry via the queue."
      },
      "steps": [
        {
          "edges": [
            "e1"
          ],
          "packet": "“What is RabbitMQ?”",
          "text": {
            "simple": "You type your question and press Send.",
            "tech": "POST /messages to the REST API."
          },
          "set": {
            "result": {
              "say": {
                "from": "user",
                "text": "What is RabbitMQ?"
              }
            }
          }
        },
        {
          "edges": [
            "e2",
            "e3"
          ],
          "packet": {
            "simple": "Task",
            "tech": "job #42"
          },
          "text": {
            "simple": "The front desk writes the question down and puts it on the waiting list.",
            "tech": "INSERT into PostgreSQL, then publish to chat.requests."
          },
          "set": {
            "qreq": {
              "slots": 1,
              "status": {
                "simple": "1 waiting",
                "tech": "1 message"
              }
            },
            "db": {
              "status": {
                "simple": "1 entry",
                "tech": "1 row"
              }
            }
          }
        },
        {
          "edges": [
            "e4"
          ],
          "text": {
            "simple": "A worker picks up the question.",
            "tech": "A worker consumes the job."
          },
          "set": {
            "qreq": {
              "slots": 0,
              "status": "empty"
            },
            "worker": {
              "status": {
                "simple": "working",
                "tech": "busy"
              },
              "tone": "strong"
            }
          }
        },
        {
          "edges": [
            "e5"
          ],
          "text": {
            "simple": "It asks Claude.",
            "tech": "LLM request to the Messages API."
          },
          "set": {
            "worker": {
              "status": {
                "simple": "waiting for Claude",
                "tech": "await response"
              }
            }
          }
        },
        {
          "edges": [
            "e6"
          ],
          "error": true,
          "packet": {
            "simple": "overloaded",
            "tech": "529 Overloaded"
          },
          "labels": {
            "e6": {
              "simple": "overloaded",
              "tech": "529"
            }
          },
          "text": {
            "simple": "Claude is overloaded right now and declines.",
            "tech": "The API responds with 529 overloaded_error."
          },
          "set": {
            "worker": {
              "status": {
                "simple": "Error",
                "tech": "Error 529"
              },
              "tone": "bad"
            }
          },
          "detail": {
            "simple": "This is not our fault: Claude simply has too many requests at this moment. The worker takes note of it.",
            "tech": "Transient error on the provider side; no retry inside the worker itself."
          }
        },
        {
          "edges": [
            "er"
          ],
          "error": true,
          "text": {
            "simple": "The worker puts the question back on the waiting list to try again shortly.",
            "tech": "Nack with requeue via a delay queue."
          },
          "set": {
            "qreq": {
              "slots": 1,
              "status": {
                "simple": "1 waiting",
                "tech": "1 message"
              }
            },
            "worker": {
              "status": {
                "simple": "ready",
                "tech": "idle"
              },
              "tone": null
            }
          },
          "detail": {
            "simple": "Instead of giving up, the question goes back on the waiting list. After a short pause it is picked up again.",
            "tech": "Nack with requeue via a delay queue; the retry counter is incremented."
          }
        },
        {
          "edges": [
            "e4",
            "e5",
            "e6"
          ],
          "labels": {
            "e6": {
              "simple": "answers",
              "tech": "response"
            }
          },
          "text": {
            "simple": "After a short pause, the second attempt works.",
            "tech": "Retry after backoff: 200 OK."
          },
          "set": {
            "qreq": {
              "slots": 0,
              "status": "empty"
            },
            "worker": {
              "status": {
                "simple": "working",
                "tech": "busy"
              },
              "tone": "strong",
              "badge": {
                "simple": "Attempt 2",
                "tech": "retry=2"
              }
            }
          }
        },
        {
          "edges": [
            "e8",
            "e10"
          ],
          "text": {
            "simple": "The courier brings the answer to you.",
            "tech": "Publish and push as in the normal case."
          },
          "set": {
            "result": {
              "say": {
                "from": "ai",
                "text": "RabbitMQ is a message broker: it distributes messages through queues."
              }
            },
            "worker": {
              "status": {
                "simple": "ready",
                "tech": "idle"
              },
              "tone": null
            }
          }
        },
        {
          "focus": "result",
          "text": {
            "simple": "The answer is in your chat – just a little later.",
            "tech": "Result delivered, no data loss."
          },
          "set": {
            "result": {
              "state": "good"
            }
          }
        }
      ],
      "explain": [
        {
          "simple": "Outside services like Claude are sometimes overloaded too. Thanks to the waiting list, your question is not lost when that happens: it is simply tried again a little later.",
          "tech": "On 529 overloaded_error the job is nacked into a delay queue and processed again after a backoff."
        }
      ]
    }
  ]
}
